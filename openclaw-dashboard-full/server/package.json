{
  "name": "openclaw-dashboard-server",
  "version": "1.0.0",
  "description": "OpenClaw Dashboard Backend API with Vercel KV support",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:start": "pm2 start dist/index.js --name openclaw-dashboard",
    "pm2:stop": "pm2 stop openclaw-dashboard",
    "pm2:restart": "pm2 restart openclaw-dashboard"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.16.0",
    "uuid": "^9.0.1",
    "chokidar": "^3.5.3",
    "axios": "^1.6.5",
    "@vercel/kv": "^1.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.10",
    "@types/uuid": "^9.0.7",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
