def main():
    parser = argparse.ArgumentParser(
        description="Memory Enhanced System CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  %(prog)s store "Python是最好的语言" --type preference --priority high
  %(prog)s search "编程语言" --limit 5
  %(prog)s list --type fact --limit 10
  %(prog)s stats
  %(prog)s demo
        """
    )
    
    parser.add_argument("--agent", "-a", help="Agent ID (默认: default)")
    
    subparsers = parser.add_subparsers(dest="command", help="可用命令")
    
    # store
    store_parser = subparsers.add_parser("store", help="存储记忆")
    store_parser.add_argument("content", help="记忆内容")
    store_parser.add_argument("--type", default="fact", 
                             choices=[t.value for t in MemoryType],
                             help="记忆类型")
    store_parser.add_argument("--priority", default="medium",
                             choices=[p.name.lower() for p in MemoryPriority],
                             help="优先级")
    store_parser.add_argument("--meta", help="JSON格式的元数据")
    store_parser.set_defaults(func=cmd_store)
    
    # search
    search_parser = subparsers.add_parser("search", help="搜索记忆")
    search_parser.add_argument("query", help="搜索查询")
    search_parser.add_argument("--limit", "-n", type=int, default=5,
                              help="返回结果数量")
    search_parser.set_defaults(func=cmd_search)
    
    # list
    list_parser = subparsers.add_parser("list", help="列出记忆")
    list_parser.add_argument("--type", "-t", choices=[t.value for t in MemoryType],
                            help="按类型过滤")
    list_parser.add_argument("--limit", "-n", type=int, default=20,
                            help="返回数量")
    list_parser.set_defaults(func=cmd_list)
    
    # stats
    stats_parser = subparsers.add_parser("stats", help="显示统计")
    stats_parser.set_defaults(func=cmd_stats)
    
    # preferences
    prefs_parser = subparsers.add_parser("preferences", help="显示用户偏好")
    prefs_parser.set_defaults(func=cmd_preferences)
    
    # context
    context_parser = subparsers.add_parser("context", help="显示近期上下文")
    context_parser.add_argument("--hours", "-h", type=int, default=24,
                               help="时间范围(小时)")
    context_parser.set_defaults(func=cmd_context)
    
    # forget
    forget_parser = subparsers.add_parser("forget", help="删除记忆")
    forget_parser.add_argument("--id", help="记忆ID")
    forget_parser.add_argument("--all", action="store_true",
                              help="清理所有过期记忆")
    forget_parser.set_defaults(func=cmd_forget)
    
    # demo
    demo_parser = subparsers.add_parser("demo", help="运行演示")
    demo_parser.set_defaults(func=cmd_demo)
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        sys.exit(1)
    
    args.func(args)


if __name__ == "__main__":
    main()
