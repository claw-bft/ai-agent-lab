{
  "id": "devops-monitoring",
  "name": "运维监控",
  "description": "指标采集 -> 异常检测 -> 告警通知 -> 自动修复 -> 报告生成",
  "nodes": [
    {"node_type": "start", "name": "开始", "position": {"x": 100, "y": 200}},
    {"node_type": "task", "name": "指标采集", "agent_id": "research-pro", "task_type": "research.search", "parameters": {"query": "${input.service_name} 系统监控指标"}, "position": {"x": 300, "y": 200}},
    {"node_type": "condition", "name": "异常检测", "config": {"condition": "${node_1_result.alert_level} != 'normal'"}, "position": {"x": 500, "y": 200}},
    {"node_type": "task", "name": "告警通知", "agent_id": "research-pro", "task_type": "research.report", "parameters": {"topic": "系统告警: ${input.service_name} - ${node_1_result.alert_level}"}, "position": {"x": 700, "y": 100}},
    {"node_type": "task", "name": "自动修复", "agent_id": "coding-pro", "task_type": "coding.generate", "parameters": {"prompt": "编写自动修复脚本处理 ${node_1_result.issue_type} 问题", "language": "python"}, "position": {"x": 700, "y": 300}},
    {"node_type": "aggregate", "name": "合并结果", "position": {"x": 900, "y": 200}},
    {"node_type": "delay", "name": "等待验证", "config": {"delay_ms": 30000}, "position": {"x": 1100, "y": 200}},
    {"node_type": "task", "name": "生成报告", "agent_id": "research-pro", "task_type": "research.report", "parameters": {"topic": "${input.service_name} 运维事件报告"}, "position": {"x": 1300, "y": 200}},
    {"node_type": "end", "name": "完成", "position": {"x": 1500, "y": 200}}
  ],
  "edges": [
    {"source": "node_0", "target": "node_1"},
    {"source": "node_1", "target": "node_2"},
    {"source": "node_2", "target": "node_3", "label": "异常", "condition": "${node_1_result.alert_level} != 'normal'"},
    {"source": "node_2", "target": "node_7", "label": "正常", "condition": "${node_1_result.alert_level} == 'normal'"},
    {"source": "node_3", "target": "node_5"},
    {"source": "node_4", "target": "node_5"},
    {"source": "node_5", "target": "node_6"},
    {"source": "node_6", "target": "node_7"},
    {"source": "node_7", "target": "node_8"}
  ],
  "input_schema": {
    "service_name": "服务名称",
    "metrics": "监控指标列表(可选)"
  },
  "output_schema": {
    "metrics_data": "采集的指标数据",
    "alert_level": "告警级别(normal/warning/critical)",
    "fix_script": "自动修复脚本",
    "incident_report": "事件报告"
  },
  "example": {
    "input": {
      "service_name": "订单服务",
      "metrics": ["CPU", "内存", "响应时间", "错误率"]
    }
  }
}
