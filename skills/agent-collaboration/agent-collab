#!/usr/bin/env python3
"""
Agent Collaboration CLI - 多Agent协作命令行工具
"""

import sys
import os
import json
import time
import argparse
from typing import Optional

# 添加当前目录到路径
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from agent_protocol import (
    create_collaboration_system, Message, MessageType,
    TaskStatus, WorkflowType
)
from skill_adapters import create_skill_agents


class AgentCollabCLI:
    """Agent协作CLI"""
    
    def __init__(self):
        self.agents = None
        self.registry = None
        self.message_bus = None
        self.orchestrator = None
        self._initialized = False
    
    def init(self):
        """初始化系统"""
        if not self._initialized:
            self.agents, self.registry, self.message_bus, self.orchestrator = create_skill_agents()
            self._initialized = True
    
    def status(self):
        """显示系统状态"""
        self.init()
        
        print("=" * 60)
        print("           Agent Collaboration Protocol Status")
        print("=" * 60)
        
        # Agent状态
        print("\n📊 Registered Agents:")
        print("-" * 40)
        for agent in self.registry.list_agents():
            health = self.registry.check_health()
            status_icon = "🟢" if agent.agent_id in health["healthy"] else "🔴"
            print(f"  {status_icon} {agent.agent_id}")
            print(f"     Role: {agent.role.value}")
            print(f"     Capabilities: {', '.join(agent.capabilities)}")
            print(f"     Status: {agent.status}")
            print()
        
        # 任务统计
        print("\n📋 Task Statistics:")
        print("-" * 40)
        all_tasks = self.orchestrator.list_tasks()
        status_counts = {}
        for task in all_tasks:
            status = task.status.value
            status_counts[status] = status_counts.get(status, 0) + 1
        
        for status, count in status_counts.items():
            print(f"  {status}: {count}")
        
        if not status_counts:
            print("  No tasks yet")
        
        print("\n" + "=" * 60)
    
    def list_agents(self):
        """列出所有Agent"""
        self.init()
        
        print("\nRegistered Agents:")
        print("-" * 40)
        for agent in self.registry.list_agents():
            print(f"  {agent.agent_id} ({agent.role.value})")
            print(f"    Capabilities: {', '.join(agent.capabilities)}")
            print()
    
    def create_task(self, task_type: str, description: str, agent: Optional[str] = None, 
                    params: Optional[str] = None, wait: int = 0):
        """创建任务"""
        self.init()
        
        parameters = {}
        if params:
            try:
                parameters = json.loads(params)
            except json.JSONDecodeError:
                print(f"Error: Invalid JSON parameters: {params}")
                return
        
        task = self.orchestrator.create_task(
            task_type=task_type,
            description=description,
            parameters=parameters
        )
        
        print(f"\n✅ Task created: {task.task_id}")
        print(f"   Type: {task_type}")
        print(f"   Description: {description}")
        
        # 分配任务
        if agent:
            success = self.orchestrator.assign_task(task.task_id, agent)
            if success:
                print(f"   Assigned to: {agent}")
            else:
                print(f"   ⚠️ Failed to assign to {agent}")
        else:
            assigned = self.orchestrator.auto_assign(task.task_id)
            if assigned:
                print(f"   Auto-assigned to: {assigned}")
        
        # 等待结果
        if wait > 0:
            print(f"\n⏳ Waiting for completion (max {wait}s)...")
            for i in range(wait):
                time.sleep(1)
                task_status = self.orchestrator.get_task(task.task_id)
                if task_status.status in [TaskStatus.COMPLETED, TaskStatus.FAILED]:
                    break
                print(f"   Status: {task_status.status.value} ({i+1}s)")
            
            task_status = self.orchestrator.get_task(task.task_id)
            print(f"\n📊 Final Status: {task_status.status.value}")
            if task_status.result:
                print(f"   Result: {json.dumps(task_status.result, indent=2, default=str)}")
            if task_status.error:
                print(f"   Error: {task_status.error}")
    
    def run_workflow(self, workflow_type: str, symbol: Optional[str] = None, 
                     product: Optional[str] = None, monitor: int = 0):
        """运行工作流"""
        self.init()
        
        master = self.agents.get("master")
        if not master:
            print("Error: Master orchestrator not found")
            return
        
        if workflow_type == WorkflowType.STOCK_RESEARCH.value:
            if not symbol:
                print("Error: --symbol required for stock-research workflow")
                return
            
            workflow_id = master.create_stock_research_workflow(symbol)
            print(f"\n📈 Stock Research Workflow Created")
            print(f"   Workflow ID: {workflow_id}")
            print(f"   Symbol: {symbol}")
        
        elif workflow_type == WorkflowType.PRODUCT_DEV.value:
            if not product:
                print("Error: --product required for product-dev workflow")
                return
            
            workflow_id = master.create_product_dev_workflow(product)
            print(f"\n🚀 Product Development Workflow Created")
            print(f"   Workflow ID: {workflow_id}")
            print(f"   Product: {product}")
        
        else:
            print(f"Error: Unknown workflow type: {workflow_type}")
            return
        
        # 监控工作流
        if monitor > 0:
            print(f"\n⏳ Monitoring workflow (max {monitor}s)...")
            for i in range(monitor):
                time.sleep(1)
                status = master.get_workflow_status(workflow_id)
                
                # 清屏并重新显示
                os.system('clear' if os.name == 'posix' else 'cls')
                print(f"\n📊 Workflow Status ({i+1}s)")
                print("-" * 40)
                print(f"Workflow ID: {workflow_id}")
                print(f"Type: {status.get('type', 'unknown')}")
                print(f"Status: {status.get('status', 'unknown')}")
                print("\nTasks:")
                for task in status.get('tasks', []):
                    icon = "✅" if task['status'] == 'COMPLETED' else "⏳" if task['status'] == 'RUNNING' else "⏸️"
                    print(f"  {icon} {task['task_id'][:8]}... - {task['status']} ({task['assigned_to']})")
                
                if status.get('status') == 'completed':
                    print("\n🎉 Workflow completed!")
                    break
            
            if status.get('status') != 'completed':
                print(f"\n⏱️ Monitoring timeout. Workflow still running.")
    
    def demo(self):
        """运行演示"""
        self.init()
        
        print("=" * 60)
        print("           Agent Collaboration Protocol Demo")
        print("=" * 60)
        
        # 显示Agent
        print("\n1️⃣  Registered Agents:")
        print("-" * 40)
        for agent in self.registry.list_agents():
            print(f"   • {agent.agent_id} ({agent.role.value})")
            print(f"     Capabilities: {', '.join(agent.capabilities[:3])}...")
        
        # 创建股票研究工作流
        print("\n2️⃣  Creating Stock Research Workflow...")
        print("-" * 40)
        master = self.agents.get("master")
        workflow_id = master.create_stock_research_workflow("600519.SH")
        print(f"   Workflow ID: {workflow_id}")
        print(f"   Symbol: 600519.SH (茅台)")
        
        # 显示任务
        print("\n3️⃣  Workflow Tasks:")
        print("-" * 40)
        status = master.get_workflow_status(workflow_id)
        for task in status.get('tasks', []):
            print(f"   • {task['task_id'][:8]}... -> {task['assigned_to']}")
        
        # 模拟执行
        print("\n4️⃣  Simulating Task Execution...")
        print("-" * 40)
        for i, task_info in enumerate(status.get('tasks', [])):
            task_id = task_info['task_id']
            task = self.orchestrator.get_task(task_id)
            
            # 标记开始
            self.orchestrator.start_task(task_id)
            print(f"   ⏳ Task {i+1} started: {task.task_type}")
            time.sleep(0.5)
            
            # 模拟完成
            self.orchestrator.complete_task(task_id, {
                "mock_result": True,
                "task_type": task.task_type,
                "completed_at": time.strftime("%Y-%m-%dT%H:%M:%S")
            })
            print(f"   ✅ Task {i+1} completed")
        
        # 最终状态
        print("\n5️⃣  Final Workflow Status:")
        print("-" * 40)
        final_status = master.get_workflow_status(workflow_id)
        print(f"   Status: {final_status.get('status', 'unknown')}")
        print(f"   All tasks completed: {final_status.get('status') == 'completed'}")
        
        print("\n" + "=" * 60)
        print("           Demo Complete!")
        print("=" * 60)


def main():
    parser = argparse.ArgumentParser(
        description="Agent Collaboration Protocol CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s status
  %(prog)s agents
  %(prog)s task --type finance.quote --description "查询茅台股票" --agent finance-pro --wait 5
  %(prog)s workflow --type stock-research --symbol 600519.SH --monitor 10
  %(prog)s workflow --type product-dev --product "AI代码助手" --monitor 20
  %(prog)s demo
        """
    )
    
    subparsers = parser.add_subparsers(dest='command', help='Available commands')
    
    # status command
    subparsers.add_parser('status', help='Show system status')
    
    # agents command
    subparsers.add_parser('agents', help='List all registered agents')
    
    # task command
    task_parser = subparsers.add_parser('task', help='Create a new task')
    task_parser.add_argument('--type', required=True, help='Task type (e.g., finance.quote)')
    task_parser.add_argument('--description', required=True, help='Task description')
    task_parser.add_argument('--agent', help='Target agent ID')
    task_parser.add_argument('--params', help='Task parameters as JSON string')
    task_parser.add_argument('--wait', type=int, default=0, help='Wait for completion (seconds)')
    
    # workflow command
    workflow_parser = subparsers.add_parser('workflow', help='Execute a predefined workflow')
    workflow_parser.add_argument('--type', required=True, choices=['stock-research', 'product-dev'],
                                help='Workflow type')
    workflow_parser.add_argument('--symbol', help='Stock symbol (for stock-research)')
    workflow_parser.add_argument('--product', help='Product name (for product-dev)')
    workflow_parser.add_argument('--monitor', type=int, default=0, help='Monitor progress (seconds)')
    
    # demo command
    subparsers.add_parser('demo', help='Run a demonstration')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    cli = AgentCollabCLI()
    
    if args.command == 'status':
        cli.status()
    
    elif args.command == 'agents':
        cli.list_agents()
    
    elif args.command == 'task':
        cli.create_task(
            task_type=args.type,
            description=args.description,
            agent=args.agent,
            params=args.params,
            wait=args.wait
        )
    
    elif args.command == 'workflow':
        cli.run_workflow(
            workflow_type=args.type,
            symbol=args.symbol,
            product=args.product,
            monitor=args.monitor
        )
    
    elif args.command == 'demo':
        cli.demo()


if __name__ == "__main__":
    main()
