#!/usr/bin/env python3
"""
Agent协作系统 CLI

统一入口，管理多Agent协作任务
"""

import sys
import os
import json
import argparse
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from agent_protocol import (
    create_collaboration_system, AgentRegistry, MessageBus, 
    TaskOrchestrator, AgentMessage, MessageType, TaskStatus
)
from skill_adapters import (
    FinanceProAgent, CodingProAgent, ProductProAgent, 
    ResearchProAgent, MasterOrchestratorAgent
)


class AgentCollaborationCLI:
    """Agent协作系统命令行界面"""
    
    def __init__(self):
        self.agents = {}
        self.registry = None
        self.bus = None
        self.orchestrator = None
        self.master = None
        self._initialized = False
    
    def init_system(self):
        """初始化协作系统"""
        if self._initialized:
            return
        
        self.registry, self.bus, self.orchestrator = create_collaboration_system()
        
        # 创建技能包Agent
        self.agents["finance"] = FinanceProAgent(self.registry, self.bus)
        self.agents["coding"] = CodingProAgent(self.registry, self.bus)
        self.agents["product"] = ProductProAgent(self.registry, self.bus)
        self.agents["research"] = ResearchProAgent(self.registry, self.bus)
        
        # 创建主编排Agent
        self.master = MasterOrchestratorAgent(
            self.registry, self.bus, self.orchestrator
        )
        self.agents["master"] = self.master
        
        self._initialized = True
        print("✅ Agent协作系统已初始化")
    
    def cmd_status(self, args):
        """查看系统状态"""
        self.init_system()
        
        print("\n=== Agent协作系统状态 ===\n")
        
        # Agent状态
        print("已注册Agent:")
        for agent_info in self.registry.list_agents():
            status = "🟢" if agent_info.get("status") == "online" else "🔴"
            caps = ", ".join(agent_info["capabilities"])
            print(f"  {status} {agent_info['agent_id']}")
            print(f"     能力: {caps}")
        
        # 任务状态
        print("\n任务状态:")
        tasks = self.orchestrator.get_all_tasks()
        if tasks:
            status_count = {}
            for task in tasks:
                status = task.status.name
                status_count[status] = status_count.get(status, 0) + 1
            
            for status, count in status_count.items():
                icon = {
                    "COMPLETED": "✅",
                    "FAILED": "❌",
                    "RUNNING": "🔄",
                    "PENDING": "⏳",
                    "ASSIGNED": "📋"
                }.get(status, "⏳")
                print(f"  {icon} {status}: {count}")
        else:
            print("  暂无任务")
        
        # 消息统计
        history = self.bus.get_history(1000)
        print(f"\n消息统计: {len(history)} 条消息")
    
    def cmd_agents(self, args):
        """列出所有Agent"""
        self.init_system()
        
        print("\n=== Agent列表 ===\n")
        for agent_info in self.registry.list_agents():
            print(f"ID: {agent_info['agent_id']}")
            print(f"  角色: {agent_info['role']}")
            print(f"  能力: {', '.join(agent_info['capabilities'])}")
            print(f"  状态: {agent_info.get('status', 'unknown')}")
            print(f"  注册时间: {agent_info.get('registered_at', 'N/A')}")
            print()
    
    def cmd_send(self, args):
        """发送消息到Agent"""
        self.init_system()
        
        message = AgentMessage(
            msg_type=MessageType[args.type.upper()],
            sender="cli",
            receiver=args.to,
            payload=json.loads(args.payload) if args.payload else {}
        )
        self.bus.publish(message)
        print(f"✅ 消息已发送给 {args.to}")
    
    def cmd_task(self, args):
        """创建并执行任务"""
        self.init_system()
        
        # 创建任务
        task = self.orchestrator.create_task(
            task_type=args.type,
            description=args.description,
            parameters=json.loads(args.params) if args.params else {},
            created_by="cli"
        )
        
        print(f"✅ 任务已创建: {task.task_id}")
        
        # 分配任务
        if args.agent:
            success = self.orchestrator.assign_task(task.task_id, args.agent)
            if success:
                print(f"✅ 任务已分配给 {args.agent}")
            else:
                print(f"❌ 分配失败，Agent {args.agent} 可能不存在")
        
        # 等待结果
        if args.wait:
            print("等待任务完成...")
            for _ in range(args.wait * 10):
                status = self.orchestrator.get_task_status(task.task_id)
                if status in [TaskStatus.COMPLETED, TaskStatus.FAILED]:
                    break
                time.sleep(0.1)
            
            task_obj = self.orchestrator._tasks.get(task.task_id)
            if task_obj:
                print(f"\n任务状态: {task_obj.status.name}")
                if task_obj.result:
                    print(f"结果: {json.dumps(task_obj.result, indent=2, ensure_ascii=False)}")
                if task_obj.error:
                    print(f"错误: {task_obj.error}")
    
    def cmd_workflow(self, args):
        """执行工作流"""
        self.init_system()
        
        if args.type == "stock-research":
            if not args.symbol:
                print("❌ 请提供股票代码: --symbol 600519.SH")
                return
            
            workflow_id = self.master.create_stock_research_workflow(args.symbol)
            print(f"✅ 股票研究工作流已创建: {workflow_id}")
            
        elif args.type == "product-dev":
            if not args.product:
                print("❌ 请提供产品想法: --product 'AI助手'")
                return
            
            workflow_id = self.master.create_product_development_workflow(args.product)
            print(f"✅ 产品开发工作流已创建: {workflow_id}")
        
        else:
            print(f"❌ 未知工作流类型: {args.type}")
            print("可用类型: stock-research, product-dev")
            return
        
        # 监控工作流
        if args.monitor:
            print("\n监控工作流执行...")
            prev_status = None
            
            for _ in range(args.monitor * 10):
                status = self.master.get_workflow_status(workflow_id)
                current = json.dumps(status, sort_keys=True)
                
                if current != prev_status:
                    print(f"\n状态更新:")
                    print(json.dumps(status, indent=2, ensure_ascii=False))
                    prev_status = current
                
                if status.get("overall_status") in ["completed", "failed"]:
                    break
                
                time.sleep(0.1)
    
    def cmd_tasks(self, args):
        """列出所有任务"""
        self.init_system()
        
        tasks = self.orchestrator.get_all_tasks()
        
        if not tasks:
            print("暂无任务")
            return
        
        print(f"\n=== 任务列表 ({len(tasks)} 个) ===\n")
        
        for task in tasks:
            icon = {
                TaskStatus.COMPLETED: "✅",
                TaskStatus.FAILED: "❌",
                TaskStatus.RUNNING: "🔄",
                TaskStatus.PENDING: "⏳",
                TaskStatus.ASSIGNED: "📋"
            }.get(task.status, "⏳")
            
            print(f"{icon} {task.task_id}")
            print(f"   类型: {task.task_type}")
            print(f"   描述: {task.description}")
            print(f"   状态: {task.status.name}")
            print(f"   分配给: {task.assigned_to or '未分配'}")
            
            if task.result:
                result_str = json.dumps(task.result, ensure_ascii=False)
                if len(result_str) > 100:
                    result_str = result_str[:100] + "..."
                print(f"   结果: {result_str}")
            
            if task.error:
                print(f"   错误: {task.error}")
            print()
    
    def cmd_demo(self, args):
        """运行演示"""
        self.init_system()
        
        print("\n=== Agent协作系统演示 ===\n")
        
        # 演示1: 创建简单任务
        print("1. 创建股票查询任务...")
        task = self.orchestrator.create_task(
            task_type="finance.quote",
            description="查询茅台股票",
            parameters={"symbol": "600519.SH"},
            created_by="demo"
        )
        print(f"   任务ID: {task.task_id}")
        
        # 分配给finance agent
        self.orchestrator.assign_task(task.task_id, "finance-pro")
        print(f"   分配给: finance-pro")
        
        # 等待并显示结果
        time.sleep(1)
        task_obj = self.orchestrator._tasks.get(task.task_id)
        if task_obj and task_obj.result:
            print(f"   结果: {json.dumps(task_obj.result, indent=2, ensure_ascii=False)}")
        
        # 演示2: 创建工作流
        print("\n2. 创建股票研究工作流...")
        workflow_id = self.master.create_stock_research_workflow("000001.SZ")
        print(f"   工作流ID: {workflow_id}")
        
        # 监控
        print("   监控工作流...")
        for _ in range(30):
            status = self.master.get_workflow_status(workflow_id)
            if status.get("overall_status") != "running":
                break
            time.sleep(0.1)
        
        print(f"   最终状态: {status.get('overall_status')}")
        
        print("\n✅ 演示完成")


def main():
    cli = AgentCollaborationCLI()
    
    parser = argparse.ArgumentParser(
        description="Agent协作系统 CLI",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  %(prog)s status                    # 查看系统状态
  %(prog)s agents                    # 列出所有Agent
  %(prog)s task --type finance.quote --description "查询茅台" --agent finance-pro
  %(prog)s workflow --type stock-research --symbol 600519.SH --monitor 10
  %(prog)s demo                      # 运行演示
        """
    )
    
    subparsers = parser.add_subparsers(dest="command", help="可用命令")
    
    # status
    subparsers.add_parser("status", help="查看系统状态")
    
    # agents
    subparsers.add_parser("agents", help="列出所有Agent")
    
    # send
    send_parser = subparsers.add_parser("send", help="发送消息")
    send_parser.add_argument("--to", required=True, help="目标Agent")
    send_parser.add_argument("--type", default="TASK", help="消息类型")
    send_parser.add_argument("--payload", help="消息内容(JSON)")
    
    # task
    task_parser = subparsers.add_parser("task", help="创建任务")
    task_parser.add_argument("--type", required=True, help="任务类型")
    task_parser.add_argument("--description", required=True, help="任务描述")
    task_parser.add_argument("--params", help="任务参数(JSON)")
    task_parser.add_argument("--agent", help="分配给哪个Agent")
    task_parser.add_argument("--wait", type=int, help="等待结果(秒)")
    
    # workflow
    workflow_parser = subparsers.add_parser("workflow", help="执行工作流")
    workflow_parser.add_argument("--type", required=True, 
                                choices=["stock-research", "product-dev"],
                                help="工作流类型")
    workflow_parser.add_argument("--symbol", help="股票代码(股票研究)")
    workflow_parser.add_argument("--product", help="产品想法(产品开发)")
    workflow_parser.add_argument("--monitor", type=int, default=10,
                                help="监控时间(秒)")
    
    # tasks
    subparsers.add_parser("tasks", help="列出所有任务")
    
    # demo
    subparsers.add_parser("demo", help="运行演示")
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return
    
    command_map = {
        "status": cli.cmd_status,
        "agents": cli.cmd_agents,
        "send": cli.cmd_send,
        "task": cli.cmd_task,
        "workflow": cli.cmd_workflow,
        "tasks": cli.cmd_tasks,
        "demo": cli.cmd_demo
    }
    
    if args.command in command_map:
        command_map[args.command](args)
    else:
        print(f"未知命令: {args.command}")


if __name__ == "__main__":
    main()
