{
  "version": 2,
  "name": "news-intelligence-hub",
  "builds": [
    {
      "src": "dashboard.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/data.json",
      "dest": "/data.json"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard.html"
    }
  ],
  "github": {
    "enabled": false
  }
}