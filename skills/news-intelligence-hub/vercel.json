{
  "version": 2,
  "name": "news-intelligence-hub",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "."
      }
    }
  ],
  "routes": [
    {
      "src": "/data.json",
      "dest": "/data.json"
    },
    {
      "src": "/(.*)",
      "dest": "/dashboard.html"
    }
  ]
}