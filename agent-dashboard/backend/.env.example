# Agent Dashboard Backend Environment Configuration

# App Settings
APP_NAME="Agent Dashboard API"
DEBUG=false
VERSION="1.0.0"

# Server Settings
HOST=0.0.0.0
PORT=8000

# Data Paths
SESSIONS_DIR=/root/.openclaw/agents/main/sessions
SKILLS_DIR=/root/.openclaw/skills
TASKS_DIR=/root/.openclaw/shared/incoming

# WebSocket Settings
WS_HEARTBEAT_INTERVAL=30

# CORS Settings
CORS_ORIGINS=["*"]
